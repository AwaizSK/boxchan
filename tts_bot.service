[Unit]
Description=Discord Piper TTS bot
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ttsbot
Group=ttsbot
# Root-owned code + interpreter; installed by scripts/setup_system.sh and scripts/deploy.sh
WorkingDirectory=/opt/tts-bot
ExecStart=/opt/tts-bot/env/bin/python bot.py
# Token: root:root 600 file, readable only by systemd; exposed to the process as $CREDENTIALS_DIRECTORY/discord_token
LoadCredential=discord_token:/etc/tts-bot/token
StateDirectory=tts-bot
# Optional, non-secret settings (the leading "-" makes a missing file fine), e.g. TTS_CHANNEL_ID=123456789012345678 as a first-boot channel seed: echo 'TTS_CHANNEL_ID=<id>' | sudo tee /etc/tts-bot/bot.env
EnvironmentFile=-/etc/tts-bot/bot.env
Environment=STATE_FILE=/var/lib/tts-bot/state.json
Environment=CONFIG_FILE=/var/lib/tts-bot/config.json
Environment=USERS_FILE=/var/lib/tts-bot/users.json
Environment=FEATURES_FILE=/var/lib/tts-bot/features.json
# Web UI binds loopback + this host's Tailscale address(es) (auto-detected, re-checked every 15 s until found). Linux answers on any local address for any interface, so the
# app also refuses connections whose SOURCE address is not loopback/Tailscale (bad_peer) and only answers allowlisted
# Host names. Secure it with Tailscale ACLs; also recommended: host firewall rules (see docs/ARCHITECTURE.md runbook).
# Optional overrides (loopback / Tailscale addresses only, comma-separated; anything else disables the GUI).
# Explicit mode retries only the listed addresses (no re-detection); always include 127.0.0.1 in the list:
#Environment=WEBUI_HOSTS=127.0.0.1,100.64.0.1
# Extra Host names the GUI should answer to (MagicDNS name, later your domain); no wildcards:
#Environment=WEBUI_ALLOWED_HOSTS=your-machine.tailnet-name.ts.net
Environment=WEBUI_PORT=8765
Environment=PIPER_MODEL_PATH=/opt/tts-bot/models/en_US-lessac-medium.onnx
Environment=PIPER_CONFIG_PATH=/opt/tts-bot/models/en_US-lessac-medium.onnx.json
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/opt/tts-bot/env/lib
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
